#!/bin/sh
# shellcheck disable=SC3043

eh() { echo "winiso2img error: $*" 1>&2; exit 1; }

cc() { for c; do command -v "$c" > /dev/null || { eh "no $c"; }; done; }

# shellcheck disable=SC2154
clean() {
    set +e
    sync                        # unmounting may fail if SIGINT
    loop_delete "$lo_src"
    loop_delete "$lo_part1"
    rm -f "$part1"
    [ "$ok" ] || rm -f "$dest"
}

loop_setup() {                  # race condition if SIGINT
    local lo mountpoint
    lo=`udisksctl loop-setup -f "$1" | grep -o '/dev/loop[0-9]*'`
    eval "$2=$lo"
    mountpoint=`udisksctl mount -b "$lo" | grep -o '/run/media/.*'`
    eval "$2_mountpoint=$mountpoint"
}

loop_delete() {
    losetup "$1" >/dev/null 2>&1 || return 0
    udisksctl unmount -b "$1" > /dev/null
    udisksctl loop-delete -b "$1"
}

copy() {
    local prefix="$1"
    local files="$2"
    local dest_dir="$3"

    [ "$V" = 0 ] || {
        local steps_total
        local steps=0
        steps_total="`echo "$files" | wc -l`"
        echo $steps
    }

    for file in $files; do
        d=$dest_dir/${file#"$prefix"/}
        [ "$DEBUG" ] || {
            dirname "$d" | xargs -d\\n mkdir -p
            cp -p "$file" "$d" || break 1
        }

        [ "$V" = 0 ] || {
            steps=$((steps+1))
            echo "$steps $steps_total" | awk '{printf "%d\n", ($1/$2)*100}'
        }
    done
}

set -e
[ "`uname -s`" = Linux ] || eh not Linux
cc udisksctl mkfs.fat wimlib-imagex sfdisk dialog

usage='[V=0] winiso2img win.iso output.img'
src="$1"; [ -f "$src" ] || eh "$usage"
dest="$2"; [ -n "$dest" ] || eh "$usage"
part1=`mktemp -u "${dest}.part1.XXXXXX"`

dialog=true; [ "$V" = 0 ] || dialog=dialog

trap clean 0 1 2 15

# STEP 1: create a fat32 partition inside a file
part1_size=$((1024*1024*1024 * 8))
mkfs.fat -C "$part1" $((part1_size / 1024)) > /dev/null

# STEP 2: mount Windows .iso and the fat32 partition
loop_setup "$src" lo_src
loop_setup "$part1" lo_part1

# STEP 3: fat32 doesn't support files > 4GB, hence split `install.wim`
# shellcheck disable=SC2154
{
    mkdir "$lo_part1_mountpoint/sources"
    [ "$DEBUG" ] ||
        wimlib-imagex split "$lo_src_mountpoint/sources/install.wim" \
                      "$lo_part1_mountpoint/sources/install.swm" 3800
}

# STEP 4: copy the rest of the files to the fat32 partition
files_src=`find "$lo_src_mountpoint" -type f | grep -v /sources/install.wim`
copy "$lo_src_mountpoint" "$files_src" "$lo_part1_mountpoint" |
    $dialog --backtitle winiso2img --keep-tite --gauge "Copying files" 0 0

# STEP 5: create an empty image and partition it
rm -f "$dest"
truncate -s $((part1_size + 2048*512)) "$dest"

sfdisk "$dest" << EOF > /dev/null
label: dos
unit: sectors
sector-size: 512
: start=2048, size=$((part1_size / 512)), type=c, bootable
EOF

# STEP 6: copy the fat32 partition file into the image file
dd_status=none; [ "$V" = 0 ] || dd_status=progress
dd if="$part1" of="$dest" conv=notrunc bs=512 seek=2048 status=$dd_status

ok=1
